<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.minispring</groupId>
        <artifactId>minispring-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mini-spring-demo</artifactId>
    <name>mini-spring-demo</name>
    <description>后端 demo 收口：一条 run() 启动 Web + AOP + 外部化配置 + 自动装配；含 M6 自动配置演示迁移</description>

    <dependencies>
        <dependency>
            <groupId>com.minispring</groupId>
            <artifactId>mini-spring-boot</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.minispring</groupId>
            <artifactId>mini-spring-web</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.minispring</groupId>
            <artifactId>mini-spring-aop</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.minispring</groupId>
            <artifactId>mini-spring-starter-demo</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <!-- demo 层允许按需引入真实基础设施依赖。 -->
        <dependency>
            <groupId>com.minispring</groupId>
            <artifactId>mini-spring-jdbc</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
        </dependency>
        <!-- HikariCP 传递引入 slf4j-api；simple 绑定让连接池启停与 evict 诊断可见。
             demo 显式提供运行时实现；autoconfigure 另有不向使用方传递的 direct optional 集成。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>1.7.36</version>
        </dependency>
    </dependencies>
</project>
