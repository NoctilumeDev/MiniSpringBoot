<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.minispring</groupId>
        <artifactId>minispring-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mini-spring-autoconfigure</artifactId>
    <name>mini-spring-autoconfigure</name>
    <description>自动配置：@Conditional 派生 + AutoConfigurationImportSelector + SPI 读取 + 框架自动配置类</description>

    <dependencies>
        <dependency>
            <groupId>com.minispring</groupId>
            <artifactId>mini-spring-context</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <!-- 三个框架依赖全部设为 optional：
             编译期可见（本模块要写 @Bean 方法），但绝不向下游传递：
             应用按需引 web/aop/config，缺失时对应自动配置经 @ConditionalOnClass(name) 安全跳过。
             Spring Boot 的 autoconfigure 同样将具体能力依赖保持为 optional。 -->
        <dependency>
            <groupId>com.minispring</groupId>
            <artifactId>mini-spring-config</artifactId>
            <version>0.1.0-SNAPSHOT</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.minispring</groupId>
            <artifactId>mini-spring-aop</artifactId>
            <version>0.1.0-SNAPSHOT</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.minispring</groupId>
            <artifactId>mini-spring-web</artifactId>
            <version>0.1.0-SNAPSHOT</version>
            <optional>true</optional>
        </dependency>
        <!-- jdbc 模板与 HikariCP 均为 optional：编译期可见、运行期不传递；
             裁掉任一依赖，对应自动配置经 @ConditionalOnClass(name) 安全跳过 -->
        <dependency>
            <groupId>com.minispring</groupId>
            <artifactId>mini-spring-jdbc</artifactId>
            <version>0.1.0-SNAPSHOT</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
            <optional>true</optional>
        </dependency>
        <!-- 仅测试期依赖；运行时保持零第三方依赖 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>
        </plugins>
    </build>
</project>
