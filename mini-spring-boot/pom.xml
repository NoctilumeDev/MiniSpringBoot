<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.minispring</groupId>
        <artifactId>minispring-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mini-spring-boot</artifactId>
    <name>mini-spring-boot</name>
    <description>启动器：MiniSpringApplication.run + @MiniSpringBootApplication + StartedEvent + Banner</description>

    <dependencies>
        <dependency>
            <groupId>com.minispring</groupId>
            <artifactId>mini-spring-autoconfigure</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <!-- run() 内用 ConfigFilePropertySourceLoader 加载 application.* -->
        <dependency>
            <groupId>com.minispring</groupId>
            <artifactId>mini-spring-config</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <!-- D45：boot 不依赖 web——服务器启动经 context 层 Lifecycle 接口驱动（web 存在时由
             WebMvcAutoConfiguration 装配 Lifecycle 实现；缺失时自动跳过），与 spring-boot 同构 -->
        <!-- 仅测试期依赖；运行时保持零第三方依赖 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <!-- 仅测试期：run() 起 web 服务器的用例需要 WebServer 接口做停服清理（运行期 boot 不依赖 web） -->
        <dependency>
            <groupId>com.minispring</groupId>
            <artifactId>mini-spring-web</artifactId>
            <version>0.1.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- 34（M0-M9 复审）：把 ${project.version} 写进 jar 清单，Banner 运行期读取，
                 消除「Banner 硬编码版本 vs pom 版本」的永久漂移 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <!-- 版本必须显式锁死（外审复核第三轮）：不锁时 Maven 报
                     'build.plugins.plugin.version is missing'——「威胁构建稳定性」，
                     未来 Maven 版本可能拒绝构建或静默换行为 -->
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>